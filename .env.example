# Copy this file to .env and fill in your values:
#   cp .env.example .env
# Never commit .env — it holds your secret API key.

# Get a key at https://console.anthropic.com -> Settings -> API Keys
ANTHROPIC_API_KEY=

# Optional: which Claude model to use (default: claude-opus-5-5)
# JARGON_MODEL=claude-haiku-5-5

# --- Gmail sign-in (optional) ---
# From Google Cloud Console -> APIs & Services -> Credentials -> OAuth client ID (Web application).
# Authorized redirect URI must be: http://localhost:5001/oauth2callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Random string that signs login cookies. Generate one with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=
